# ==============================================================================
# AFILIADO AUTO - EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env.local (no frontend) ou configure via Cloudflare Secrets
# NUNCA versione arquivos .env ou credenciais reais no GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND (Vercel ou Desenvolvimento Local)
# ------------------------------------------------------------------------------
# Em produção na Vercel: URL pública do seu Cloudflare Worker (ex: https://api.seudominio.com)
# Em desenvolvimento local: deixe em branco para usar os endpoints locais integrados
NEXT_PUBLIC_API_URL=https://api.seudominio.com

# ------------------------------------------------------------------------------
# BACKEND / CLOUDFLARE WORKER (Definir via `wrangler secret put <NOME>`)
# ------------------------------------------------------------------------------
# Chave secreta para assinatura dos tokens JWT do administrador
JWT_SECRET=sua-chave-secreta-jwt-super-segura-2026

# Credenciais oficiais da Shopee Affiliate Open API
SHOPEE_APP_ID=seu_shopee_app_id
SHOPEE_APP_SECRET=seu_shopee_app_secret
SHOPEE_ENDPOINT=https://open-api.affiliate.shopee.com.br/graphql

# Conexão com o WhatsApp (Evolution API / Baileys)
# Em desenvolvimento local: http://127.0.0.1:8080
# Em produção via Cloudflare Tunnel: https://evolution.seudominio.com
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=afiliado-auto-secret-key-2026
EVOLUTION_INSTANCE=afiliado-auto

# Cloudflare Access (Opcional - caso queira proteger o Cloudflare Tunnel com Service Token)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
